# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 커밋되지 않습니다.

# ── 배경 지도 타일 ────────────────────────────────────────────────────
# 상세 단계(구 또는 구가 없는 시·군)에서 까는 배경 지도.
# 비워두면 OpenStreetMap 공개 타일을 쓴다. OSM 공개 서버는 가벼운 사용을 전제로 한
# 무료 서비스이므로, 운영에 올릴 때는 브이월드(국토교통부)로 바꾸는 것이 맞다.
#
# 브이월드 키 발급: https://www.vworld.kr → 오픈API → 인증키 발급 (무료)
#   - 서비스 유형은 "웹서비스", 도메인에 배포 주소를 등록해야 한다
#     (예: joongyu01.github.io)
# VITE_TILE_URL=https://api.vworld.kr/req/wmts/1.0.0/발급받은키/Base/{z}/{y}/{x}.png
# VITE_TILE_ATTRIBUTION=국토교통부 브이월드
# VITE_TILE_MAX_ZOOM=19

# ── 오피넷 OpenAPI ────────────────────────────────────────────────────
# 주유소 좌표를 전량 정확히 채울 때 쓴다 (npm run coords).
# 없으면 npm run coords:osm 으로 일부만 채워진다.
# 발급: https://www.opinet.co.kr → 오픈API
# OPINET_API_KEY=
